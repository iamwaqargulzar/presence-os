# Copy to .env for local development. Never commit .env. No real values here.
# Generate a key: uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
PRESENCE_SECRET_KEY=
PRESENCE_DEBUG=1
PRESENCE_ALLOWED_HOSTS=127.0.0.1,localhost
PRESENCE_LOG_LEVEL=INFO
# Local PostgreSQL from compose.yaml. Generate a password the same way as the key.
PRESENCE_DB_PASSWORD=
# Django's two roles (make services-up creates them): migrations run as presence_migrator, requests as presence_app.
PRESENCE_DB_MIGRATOR_PASSWORD=
PRESENCE_DB_APP_PASSWORD=
PRESENCE_DB_PORT=15432
