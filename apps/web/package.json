{
  "name": "presence-web",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "lint": "biome lint",
    "fmt": "biome format --write",
    "fmt-check": "biome format",
    "typecheck": "tsc --noEmit",
    "test": "node --test"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
