# Copy to edge.env on the Edge VM (never commit edge.env). No secrets here: the tunnel
# credentials stay in a root-only file outside the repository.
PRESENCE_TUNNEL_ID=00000000-0000-0000-0000-000000000000
PRESENCE_TUNNEL_CREDENTIALS=/etc/presence/cloudflared-credentials.json
PRESENCE_TEST_HOST=edge-test.iamwaqargulzar.com
PRESENCE_CONSOLE_HOST=console.iamwaqargulzar.com
