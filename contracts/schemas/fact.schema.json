{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Fact",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "kind",
    "value",
    "status",
    "confidence",
    "observed_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "kind": {
      "type": "string"
    },
    "value": {},
    "status": {
      "enum": [
        "CANDIDATE",
        "CANONICAL",
        "CONFLICTED",
        "SUPERSEDED",
        "REJECTED"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "owner": {
      "type": [
        "string",
        "null"
      ]
    },
    "language": {
      "type": [
        "string",
        "null"
      ]
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "fresh_until": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "supersedes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
