{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MemoryItem",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "type",
    "content",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "type": {
      "enum": [
        "FACT",
        "PREFERENCE",
        "DECISION",
        "CONVERSATION_SUMMARY",
        "TASK_STATE"
      ]
    },
    "content": {},
    "source_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SUPERSEDED",
        "DELETED"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "superseded_by": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
