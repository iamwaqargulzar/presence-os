{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "BudgetReservation",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "amount",
    "currency",
    "state",
    "expires_at"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "amount": {
      "type": "number",
      "minimum": 0
    },
    "currency": {
      "type": "string",
      "minLength": 3,
      "maxLength": 3
    },
    "state": {
      "enum": [
        "RESERVED",
        "SETTLED",
        "RELEASED",
        "EXPIRED"
      ]
    },
    "actual_amount": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "purpose": {
      "type": [
        "string",
        "null"
      ]
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
