{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AttentionItem",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "priority",
    "title",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "priority": {
      "enum": [
        "URGENT",
        "IMPORTANT",
        "NORMAL",
        "BACKGROUND"
      ]
    },
    "title": {
      "type": "string"
    },
    "summary": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "recommended_action": {
      "type": [
        "object",
        "null"
      ]
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "status": {
      "enum": [
        "OPEN",
        "ACKNOWLEDGED",
        "RESOLVED",
        "DISMISSED",
        "EXPIRED"
      ]
    }
  },
  "additionalProperties": false
}
