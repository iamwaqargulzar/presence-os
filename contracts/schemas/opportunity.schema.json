{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Opportunity",
  "type": "object",
  "required": [
    "id",
    "tenant_id",
    "title",
    "impact",
    "confidence",
    "effort",
    "status"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "title": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "impact": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "effort": {
      "type": "number",
      "minimum": 0
    },
    "estimated_cost": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0
    },
    "expected_benefit": {
      "type": [
        "string",
        "null"
      ]
    },
    "skill_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "goal_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "NEW",
        "REVIEWED",
        "ACCEPTED",
        "IN_PROGRESS",
        "DONE",
        "DISMISSED",
        "STALE"
      ]
    }
  },
  "additionalProperties": false
}
